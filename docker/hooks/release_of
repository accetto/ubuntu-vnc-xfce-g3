#!/bin/bash

main() {
    local result=""
    local response=""
    local subject=${1:?'Subject must be provided as the first parameter!'}

    ### Warning! The log name must be synchronized with the 'builder.sh' script!
    local curl_output="scrap_release_of.log"

    # ensure the log file exists
    touch "${curl_output}"

    case "${subject}" in

        ### Careful, this is used also by 22.04 and 24.04 images!
        chromium-1804 )
            # result=$(wget -qO- \
            # result=$(curl -sLN \
            #     http://archive.ubuntu.com/ubuntu/pool/universe/c/chromium-browser/ \
            #     | grep -Po -m1 '(?<=href=")[^_]*_([0-9.]+-0ubuntu\d+\.18\.04\.[^_"]*)_[^"]*' \
            #     | cut -d _ -f 2 \
            # )
            response=$(curl -sLN http://archive.ubuntu.com/ubuntu/pool/universe/c/chromium-browser/)
            if [[ -n "${response}" ]] ; then
                result=$(echo "${response}" | grep -Po -m1 '(?<=href=")[^_]*_([0-9.]+-0ubuntu\d+\.18\.04\.[^_"]*)_[^"]*' | cut -d _ -f 2)
            fi
            ;;

        * )
            echo "Exiting '${0}' with code '1' because of unknown subject '${1}'"
            return 1
            ;;

    esac

    if [[ -n "${result}" ]] ; then

        echo "${result}"
    else
        ### log the unexpected 'curl' response into the log file
        echo -e "\n==> EXECUTING @$(date -u +'%Y-%m-%d_%H-%M-%S'): ${0} $@\n\n${response}\n" >> "${curl_output}"

        echo "ERROR: Exiting '${0}' with code '1' because unable to get version of '${subject}'"
        echo "ERROR: Unexpected HTTPS response (see the file '${curl_output}')"
        return 1
    fi
}

main $@
